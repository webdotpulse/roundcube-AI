{
    "name": "Material Design",
    "extends": "elastic",
    "author": "Webdotpulse & LifePrisma AI",
    "license": "MIT",
    "version": "1.0.0",
    "config": {
        "layout": "widescreen",
        "jquery_ui_colors_theme": "material",
        "embed_css_location": "/assets/styles/styles.css",
        "editor_css_location": "/assets/styles/styles.css",
        "media_browser_css_location": "none",
        "dark_mode_support": true,
        "additional_logo_types": ["dark"],
        "xskin_default_icons": "material",
        "xskin_default_list_icons": true,
        "xskin_default_button_icons": true,
        "xskin_default_font_family": "roboto",
        "xskin_default_font_size": "n",
        "xskin_default_thick_font": false,
        "xskin_default_color": "1a73e8",
        "default_btn_primary_bg": "#1a73e8",
        "default_btn_secondary_bg": "#e8f0fe",
        "default_btn_radius": "20px"
    }
}
