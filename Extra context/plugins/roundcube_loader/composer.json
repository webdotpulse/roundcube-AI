        "page-loader",
        "gmail",
        "login-loader",
        "splash-screen",
        "progress-bar"
    ],
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Webdotpulse",
            "homepage": "https://github.com/webdotpulse"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "roundcube/plugin-installer": ">=0.1.6"
    },
    "extra": {
        "roundcube": {
            "min-version": "1.4.0"
        }
    }
}
