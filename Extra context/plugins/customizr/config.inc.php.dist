<?php

// Section under Settings > Preferences where these options appear ('customizr' or 'general')
// Default is 'customizr' (dedicated "Custom Appearance" section).
$config['customizr_settings_section'] = 'customizr';

// Define a custom watermark image (relative or absolute URL, or uploaded path)
$config['custom_watermark_image'] = './skins/watermark.png';

// Define a custom URI to be displayed instead of the empty watermark page
$config['custom_watermark_uri'] = '';

// Define a custom favicon image (empty string to remove it; default is standard icon.png / favicon.png)
$config['custom_favicon'] = 'skins/gmail_plus/assets/images/favicon.png';

// Define a custom logo image for the mailbox / webmail interface (empty string falls back to skin default / standard Grid Mail SVG)
$config['custom_logo'] = 'skins/gmail_plus/assets/images/logo_header.svg';

// Define a custom logo image specifically for the login page (empty string falls back to custom_logo / standard Grid Mail SVG)
$config['custom_logo_login'] = 'skins/gmail_plus/assets/images/logo_login.svg';


// Defines a custom CSS file which is added to every page
$config['custom_stylesheet'] = './skins/custom.css';

// Defines custom inline CSS rules to inject directly into every page
$config['custom_css'] = '';

// Optional: Prevent users from overriding specific options in the Settings UI:
// $config['dont_override'] = ['custom_watermark_image', 'custom_watermark_uri', 'custom_favicon', 'custom_logo', 'custom_logo_login', 'custom_stylesheet', 'custom_css'];