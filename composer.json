{
    "name": "webdotpulse/roundcube-ai",
    "type": "roundcube-plugin",
    "description": "Gemini Executive Assistant for Roundcube. Autonomous email triage, executive briefings, action item checklists, and draft replies powered exclusively by Google Gemini.",
    "license": "MIT",
    "version": "2.1.0",
    "keywords": [
        "roundcube",
        "plugin",
        "ai",
        "gemini",
        "google-gemini",
        "executive-assistant",
        "email-triage",
        "auto-draft",
        "email",
        "assistant",
        "lifeprisma",
        "webdotpulse",
        "gmail_plus",
        "customizr",
        "thread_drafts",
        "thunderbird_labels",
        "xcalendar",
        "roundcube_loader",
        "page-loader",
        "xmultibox",
        "xsignature",
        "newsletter",
        "email_scheduler",
        "twofactor_auth",
        "roundcube_attachments",
        "vacation_forward",
        "merge_and_fix",
        "merge-contacts",
        "persistent_login",
        "remember_me",
        "easy_unsubscribe",
        "easy-unsubscribe",
        "unsubscribe"
    ],
    "authors": [
        {
            "name": "Webdotpulse",
            "homepage": "https://github.com/webdotpulse"
        },
        {
            "email": "eduardostern@icloud.com",
            "homepage": "https://lifeprisma.com",
            "name": "Eduardo Stern"
        }
    ],
    "homepage": "https://github.com/webdotpulse/roundcube-AI",
    "replace": {
        "lifeprisma/roundcube-ai": "self.version",
        "lifeprisma/roundcube-genia": "self.version",
        "roundcubeplus/email_scheduler": "self.version",
        "roundcubeplus/persistent_login": "self.version",
        "roundcubeplus/roundcube_attachments": "self.version",
        "roundcubeplus/twofactor_auth": "self.version",
        "roundcubeplus/vacation_forward": "self.version",
        "roundcubeplus/xcalendar": "self.version",
        "roundcubeplus/xmultibox": "self.version",
        "roundcubeplus/xsignature": "self.version",
        "webdotpulse/lifeprisma-ai": "self.version",
        "webdotpulse/newsletter": "self.version",
        "webdotpulse/persistent-login": "self.version",
        "webdotpulse/roundcube-loader": "self.version",
        "webdotpulse/merge-and-fix": "self.version",
        "webdotpulse/easy_unsubscribe": "self.version",
        "roundcubeplus/easy_unsubscribe": "self.version"
    },
    "suggest": {
        "ext-curl": "Required by xcalendar for CalDAV synchronization and remote calendars",
        "ext-gd": "Required by xsignature for image signature generation",
        "ext-openssl": "Required for cryptographic tokens and authentication in newsletter, xcalendar, and twofactor_auth"
    },
    "require": {
        "php": ">=8.0",
        "roundcube/plugin-installer": ">=0.1.3"
    },
    "extra": {
        "roundcube": {
            "min-version": "1.5.0",
            "max-version": "1.8.99",
            "post-install-script": "bin/install-extra.php",
            "post-update-script": "bin/install-extra.php",
            "persistent-files": [
                "config.inc.php",
                "data/ai_memory.json",
                "data/memory",
                "data/spam"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/install-extra.php --activate"
        ],
        "post-update-cmd": [
            "@php bin/install-extra.php --activate"
        ],
        "post-create-project-cmd": [
            "@php bin/install-extra.php --activate"
        ]
    }
}
