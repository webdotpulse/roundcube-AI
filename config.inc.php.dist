<?php

/**
 * Gemini Executive Assistant for Roundcube
 *
 * An autonomous, intelligent email assistant powered exclusively by Google Gemini.
 * Features automated email triage, executive briefings, extracted action items,
 * integration with message labels, persistent AI memory, and draft replies.
 *
 * Copy this file to config.inc.php and adjust the settings below.
 */

// ============================================================
// Google Gemini API Configuration (Required)
// ============================================================
// Get your free or paid API key at: https://aistudio.google.com/apikey
$config['lifeprisma_ai_gemini_api_key'] = '';

// Default Gemini model to use
// Available options:
//   'gemini-3.8-flash'       — Newest, most intelligent Flash model (1M context, 64k output, tunable thinking) [Default]
//   'gemini-3.8-flash-cyber' — Specialized model for vulnerability management and security analysis
//   'gemini-3.7-flash'       — Previous iteration, fully supported
//   'gemini-3.6-flash'       — High-efficiency model released earlier in 2026
//   'gemini-3.5-flash'       — Optimized for scale, agentic workflows, and fast multimodal tasks
//   'gemini-3.5-flash-lite'  — Ultra-fast, lightweight, highly cost-effective
$config['lifeprisma_ai_gemini_model'] = 'gemini-3.8-flash';

// Available Gemini models for users/admin
$config['lifeprisma_ai_gemini_models'] = [
    'gemini-3.8-flash',
    'gemini-3.8-flash-cyber',
    'gemini-3.7-flash',
    'gemini-3.6-flash',
    'gemini-3.5-flash',
    'gemini-3.5-flash-lite',
];

// Official Google Gemini OpenAI-compatible endpoint URL
$config['lifeprisma_ai_api_url'] = 'https://generativelanguage.googleapis.com/v1beta/openai/chat/completions';

// ============================================================
// Autonomous Executive Assistant & Triage Settings
// ============================================================
// Controls proactive intelligence when emails are viewed or received.
//
// Options:
//   'open'     — (Recommended) Automatically triage, generate executive briefing & draft reply when opening an email
//   'receive'  — Automatically triage and create background drafts when new emails land in INBOX
//   'disabled' — Manual on-demand only (user must trigger via button)
$config['lifeprisma_ai_auto_draft_mode'] = 'open';

// ============================================================
// Message Triage & Label Integration (roundcube-labels)
// ============================================================
// Automatically applies IMAP keywords/labels (compatible with roundcube-labels
// and Thunderbird Labels) based on Gemini email classification and urgency.
$config['lifeprisma_ai_triage_labels_enabled'] = true;

// Mapping of triage category & urgency to IMAP label flags:
//   $Label1 = Blue   (1: To Respond)
//   $Label2 = Slate  (2: FYI)
//   $Label3 = Red    (3: Important)
//   $Label4 = Green  (4: Marketing & Newsletters)
//   $Label5 = Orange (5: ToDo)
$config['lifeprisma_ai_triage_label_map'] = [
    'to_respond'            => '$Label1', // 1: To Respond
    'fyi'                   => '$Label2', // 2: FYI
    'important'             => '$Label3', // 3: Important
    'marketing_newsletters' => '$Label4', // 4: Marketing & Newsletters
    'todo'                  => '$Label5', // 5: ToDo
    // Fallback aliases for backward compatibility:
    'action_required'       => '$Label1',
    'action_required_high'  => '$Label3',
    'meeting'               => '$Label1',
    'follow_up'             => '$Label1',
    'newsletter'            => '$Label4',
    'scam'                  => '$Label3',
];

// ============================================================
// AI Learning & Memory (Question-Answer Replication)
// ============================================================
// Enables persistent knowledge memory so the AI learns from past client replies.
// When a client asks a question similar to an already answered question, the AI replicates
// and adapts the verified answer consistently.
$config['lifeprisma_ai_memory_enabled'] = true;

// Auto-learn Q&A pairs from sent email replies
$config['lifeprisma_ai_memory_auto_learn'] = true;

// Maximum past answered questions injected into prompt context for replication
$config['lifeprisma_ai_memory_max_items'] = 25;

// ============================================================
// Templates & Attachment Settings
// ============================================================
// Directory path for template attachments
$config['lifeprisma_ai_template_attachments_dir'] = __DIR__ . '/attachments/templates';

// Smart filter: only draft reply if the email asks questions, has deadlines, or expects action/response
// Skips newsletters, marketing, bulk notifications, and auto-generated alerts
$config['lifeprisma_ai_auto_draft_filter'] = true;

// Default language for summaries and generated drafts
// Supported: 'English', 'Portuguese', 'Spanish', 'French', 'German', 'Italian', 'Dutch'
$config['lifeprisma_ai_default_language'] = 'English';

// Default tone for drafted replies
// Supported: 'professional', 'concise', 'friendly', 'formal', 'direct'
$config['lifeprisma_ai_default_tone'] = 'professional';

// Smart Compose: inline AI autocomplete while typing in compose window
$config['lifeprisma_ai_smart_compose'] = true;

// ============================================================
// System & Operational Safeguards
// ============================================================
// Maximum tokens generated per response
$config['lifeprisma_ai_max_tokens'] = 2048;

// Generation temperature (0.0 to 1.0, default: 0.4 for reliable executive communication)
$config['lifeprisma_ai_temperature'] = 0.4;

// Minimum seconds between requests per user to prevent flooding (default: 2)
$config['lifeprisma_ai_rate_limit'] = 2;

// Admin users — list of email addresses or usernames with access to the Admin Panel in Settings
$config['lifeprisma_ai_admins'] = [
    // 'admin@yourdomain.com',
];

// ============================================================
// 24/7 Offline Background Worker (CLI / Cron / Systemd)
// ============================================================
// Allows Gemini to monitor emails and prepare draft replies even when users
// are completely logged out of Roundcube.
// Run via CLI: php bin/worker.php (cron) or php bin/worker.php --daemon (systemd)

// Default IMAP server for the worker
// IMPORTANT: On managed hosting platforms (such as Combell, cPanel, Plesk),
// the web server and mail server are separated. Do NOT use 'localhost' if connection is refused.
// Use your provider's IMAP host, e.g.:
//   Combell:               'ssl://imap.combell.com:993' or 'ssl://mail.thechargegrid.com:993'
//   Self-hosted / VPS:     'ssl://localhost:993'
$config['lifeprisma_ai_worker_imap_host'] = 'ssl://mail.thechargegrid.com:993';

// List of email accounts to monitor in background
// Method A: Enter individual email and password for each account to monitor.
// Method B: Leave password blank and configure Dovecot Master User below.
$config['lifeprisma_ai_worker_accounts'] = [
    /*
    [
        'email' => 'koen@thechargegrid.com',
        'password' => 'secret_app_password', // your mailbox password
        'imap_host' => 'ssl://mail.thechargegrid.com:993', // optional override
        'drafts_folder' => 'Drafts',
    ],
    */
];

// Dovecot Master User Support (Optional, recommended for multi-user servers)
// Allows the background worker to access all accounts on your server using a single
// Dovecot master login, eliminating the need to store individual user passwords.
$config['lifeprisma_ai_worker_dovecot_master_user'] = '';
$config['lifeprisma_ai_worker_dovecot_master_password'] = '';

